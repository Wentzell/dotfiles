#!/usr/bin/env python3

# This file will parse all the commit messages starting from the last tagged commit
# and group them according to their [tag]'s
#
# Usage: parse_commits > out.md

import sys, re, argparse
from subprocess import check_output

mdict = { "General": [] }

parser = argparse.ArgumentParser(description="""
A script to parse the commit messages up to a given commit / tag and group them by [topic]""")
parser.add_argument('-tag', nargs=None, default=None, help="The commit / tag up to which to parse. Defaults to latest tag")
args, additional_args = parser.parse_known_args()

name_filter = {
        "tayral" : "Thomas Ayral",
        "phibeck" : "Sophie Beck",
        "mmorale3" : "Miguel Morales",
        "iskakoff" : "Sergei Iskakov",
        "Hugo Strand" : "Hugo U. R. Strand",
        "Harry LaBollita" : "Harrison LaBollita",
        "nkavokine" : "Nikita Kavokine",
        "jasonkaye" : "Jason Kaye",
        "the-hampel" : "Alexander Hampel",
        "jcoulter12" : "Jennifer Coulter",
        "Jenny Coulter" : "Jennifer Coulter",
        "Emmanuel CASTIEL" : "Emmanuel Castiel"
        }

filter_name = lambda x: name_filter.get(x, x)

def run(cmd):
    return [ln.strip() for ln in check_output(cmd.split(), text=True).splitlines()]

if __name__ == "__main__":

    # Parse all commits starting from the last tag
    start_commit = run("git describe --tags --abbrev=0")[0] if args.tag is None else args.tag

    # Commit Messages
    commit_messages = run("git log -i -E --no-merges --pretty=format:%s {}..HEAD".format(start_commit))

    # Author List sorted by last name, including any Co-authored-by trailers.
    # Note: authors of squash-merged PRs collapse into the merger's %an and are
    # not recoverable here -- cross-check contributors manually for a release.
    raw_authors = run("git log -i -E --no-merges --pretty=format:%an {}..HEAD".format(start_commit))
    coauthor_lines = run("git log -i -E --no-merges --pretty=format:%(trailers:key=Co-authored-by,valueonly) {}..HEAD".format(start_commit))
    # Drop any AI assistant (claude / anthropic in the trailer name or email) before
    # stripping the email, then add the co-author name.
    raw_authors += [re.sub(r'\s*<.*?>\s*$', '', ln) for ln in coauthor_lines
                    if ln and not any(b in ln.lower() for b in ('claude', 'anthropic'))]
    # Also drop copy-right/clang-format bots and any claude/anthropic %an name.
    bots = ('clang_format', 'gen_copyright')
    keep = lambda a: a and a not in bots and not any(b in a.lower() for b in ('claude', 'anthropic'))
    authors = sorted({filter_name(a) for a in raw_authors if keep(a)}, key=lambda x: (x.split() or [x])[-1])

    # App4Triqs Commit Messages (exclude these)
    app4triqs_branches = []
    for branch in run("git branch -a"):
        if branch[:2] in ("* ", "+ "): branch = branch[2:]  # strip current/worktree marker
        if "->" in branch: continue
        if "app4triqs" in branch:
            app4triqs_branches.append(branch)
    app4triqs_commit_messages = []
    for branch in app4triqs_branches:
        app4triqs_commit_messages.extend(run("git log -i -E --pretty=format:%s {}".format(branch)))

    # Iterate through the git log items and group them
    for line in commit_messages:
        if line in app4triqs_commit_messages: continue

        m = re.match(r'\[(.*?)\] (.*)', line)
        if m:
            if m.group(1) in mdict:
                mdict[m.group(1)].append(m.group(2))
            else:
                mdict[m.group(1)] = [m.group(2)]
        else:
            mdict["General"].append(line)

    sys.stdout.write("\n\nWe thank all contributors: " + ", ".join(authors) + "\n")
    sys.stdout.write("\nFind below an itemized list of changes in this release.\n")
    for group, mlist in mdict.items():
        if not mlist: continue
        sys.stdout.write("\n### " + group + "\n")

        for m in mlist:
            sys.stdout.write("* " + m.rstrip() + "\n")
